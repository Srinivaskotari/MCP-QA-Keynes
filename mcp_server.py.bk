from fastmcp import FastMCP
from typing import Optional
import requests

BASE_URL = "http://localhost:8000"
GA4_LAMBDA_URL = "https://z7cu9l3sd2.execute-api.us-east-1.amazonaws.com/ga4"

mcp = FastMCP("Keynes QA Advertiser Intelligence")


# =========================================================
# CURRENT DATE
# =========================================================

@mcp.tool()
def get_current_date():
    """
    Returns today's real date and pre-computed date ranges.
    ALWAYS call this first when the user uses any relative date term:
    'this month', 'last month', 'this week', 'last week', 'today',
    'yesterday', 'recent', 'last 7 days', 'last 30 days'.
    Never guess or assume dates from memory.
    """
    response = requests.get(f"{BASE_URL}/current-date")
    return response.json()


# =========================================================
# DATASETS
# =========================================================

@mcp.tool()
def get_available_datasets():
    response = requests.get(f"{BASE_URL}/datasets")
    return response.json()


# =========================================================
# TABLE SCHEMA
# =========================================================

@mcp.tool()
def get_table_schema(table_name: str):
    """
    Returns actual Athena schema for a dataset.
    Use before querying if unsure about column names.
    """
    response = requests.get(f"{BASE_URL}/schema/{table_name}")
    return response.json()


# =========================================================
# QUERY ATHENA
# =========================================================

@mcp.tool()
def query_athena(sql: str):
    """
    Executes a SQL query against Athena and returns results.
    Pick the correct table based on the question:
    - client_reporting_date_dataset                  -> daily trends, spend, ROAS, CTR, device, browser, creative
    - client_reporting_geo_dataset                   -> geography, state, region, DMA, country
    - client_reporting_network_dataset_myreports     -> network, site, publisher, supply vendor
    - client_reporting_hour_dataset                  -> hour of day, daypart, day of week

    CRITICAL DATE FILTER RULE:
    The date column is of type DATE. Always filter using:
        WHERE date BETWEEN DATE 'YYYY-MM-DD' AND DATE 'YYYY-MM-DD'
    The DATE keyword before the string is REQUIRED for Athena to cast correctly.
    Never use string comparison or CAST() for date filtering.
    """
    print("\n[MCP TOOL] query_athena called")
    print("\nGenerated SQL:")
    print(sql)
    response = requests.post(f"{BASE_URL}/query", json={"sql": sql})
    return response.json()


# =========================================================
# GA4 DATA
# =========================================================

@mcp.tool()
def get_ga4_data(
    advertiser: str,
    start_date: str,
    end_date: str,
    level: str = "daily",
    metric_set: str = "core",
    city: Optional[str] = None,
    region: Optional[str] = None,
    device: Optional[str] = None,
    channel: Optional[str] = None,
    country: Optional[str] = None,
    source: Optional[str] = None,
    medium: Optional[str] = None,
):
    """
    Fetches GA4 website data (sessions, users, transactions, revenue) for a Keynes advertiser.
    ALWAYS call get_current_date first if the user mentions relative dates.

    ── WHEN TO USE THIS TOOL ───────────────────────────────────────────────

    Use get_ga4_data ALONE for pure website behaviour questions:
      - Sessions, traffic, bounce rate, engagement
      - "How many sessions did X get?", "What's the daily traffic trend?"
      - Channel, source/medium, device, city, country breakdowns

    Use get_ga4_data AND query_athena TOGETHER only for these two joins:
      - Date join:   Athena client_reporting_date_dataset (by date)
                     + GA4 level="daily"  →  join on date
      - Region join: Athena client_reporting_geo_dataset (by region)
                     + GA4 level="region" →  join on region (state name)
      Fire both calls in parallel — do not wait for one before starting the other.

    NEVER join GA4 channel data with Athena channel data — they are
    completely different classifications and must not be combined.

    When the user asks at a level below date or region (device, city, source/medium etc.)
    return GA4 data only and tell the user:
    "Keynes cost data is only available at the date or region level."

    ── COMBINED METRIC NAMING ───────────────────────────────────────────────

    When computing metrics from GA4 + Athena spend, always use these names:
      Web ROAS            = GA4 purchaseRevenue / Athena spend
      Web CPA             = Athena spend / GA4 transactions
      Web cost per session = Athena spend / GA4 sessions
    NEVER label these as ROAS or CPA — those are Keynes platform metrics from Athena only.

    ── LEVELS ───────────────────────────────────────────────────────────────

    level="range"              → single aggregate row for the period
    level="daily"              → by date
    level="channel"            → by GA4 channel group
    level="source_medium"      → by source / medium
    level="device"             → by device category (mobile/desktop/tablet)
    level="region"             → by state/region
    level="city"               → by city
    level="country"            → by country
    level="dma"                → by DMA/metro (GA4 city dimension proxy)
    level="date_channel"       → daily × channel
    level="date_device"        → daily × device
    level="date_source_medium" → daily × source/medium
    level="date_region"        → daily × region
    level="date_city"          → daily × city
    level="date_country"       → daily × country
    level="date_dma"           → daily × DMA

    ── METRIC SETS ──────────────────────────────────────────────────────────

    metric_set="core"   (default) → sessions, totalUsers, newUsers, transactions,
                                    purchaseRevenue, totalRevenue, averagePurchaseRevenue,
                                    sessionConversionRate, bounceRate, engagementRate
    metric_set="funnel" → core + addToCarts, checkouts, engagedSessions, screenPageViews
    metric_set="all"    → funnel + ecommercePurchases, userConversionRate,
                          cartToViewRate, purchaseToViewRate, sessionDuration

    ── FILTERS ──────────────────────────────────────────────────────────────

    Filters only apply when the matching dimension is in the chosen level.
    Silently ignored otherwise — no error raised.

      city     → exact match (levels: city, date_city, dma, date_dma)
      region   → exact match (levels: region, date_region, city, date_city)
      device   → exact match: "mobile", "desktop", "tablet"
      channel  → exact match on GA4 channel group name
      country  → exact match on country name
      source   → contains match on session source
      medium   → contains match on session medium

    ── DATE FORMAT ──────────────────────────────────────────────────────────

    Always YYYY-MM-DD. Call get_current_date for relative date ranges.

    ── METRIC WARNING ───────────────────────────────────────────────────────

    sessions, totalUsers, newUsers are NON-ADDITIVE across dimension rows.
    Use level="range" for accurate site-wide totals.
    transactions, purchaseRevenue, totalRevenue ARE additive across rows.
    All metric values are returned as strings — coerce to numbers before arithmetic.
    """
    print(f"\n[MCP TOOL] get_ga4_data called: advertiser={advertiser} level={level} {start_date}->{end_date}")

    payload = {
        "keynes_advertiser": advertiser,
        "start_date":        start_date,
        "end_date":          end_date,
        "level":             level,
        "metric_set":        metric_set,
    }

    if city:    payload["city"]    = city
    if region:  payload["region"]  = region
    if device:  payload["device"]  = device
    if channel: payload["channel"] = channel
    if country: payload["country"] = country
    if source:  payload["source"]  = source
    if medium:  payload["medium"]  = medium

    try:
        response = requests.get(GA4_LAMBDA_URL, params=payload, timeout=60)
        response.raise_for_status()
        data = response.json()
    except requests.exceptions.Timeout:
        return {"error": "GA4 Lambda timed out after 60s. Try a shorter date range."}
    except requests.exceptions.RequestException as e:
        return {"error": f"Request to GA4 Lambda failed: {e}"}

    if data.get("statusCode", 200) != 200:
        return {
            "error":       data.get("error", "Unknown error from Lambda"),
            "status_code": data.get("statusCode"),
            "advertiser":  advertiser,
            "level":       level,
            "date_range":  f"{start_date} -> {end_date}",
        }

    return data


# =========================================================
# MAIN
# =========================================================

if __name__ == "__main__":
    print("\nStarting Keynes QA MCP Server...")
    mcp.run(
        transport="sse",
        host="0.0.0.0",
        port=9000
    )
